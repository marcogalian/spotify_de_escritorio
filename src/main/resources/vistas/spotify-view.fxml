<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.marcog.spotify_de_escritorio.controller.SpotifyController"
      spacing="10"
      alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <TextField fx:id="artistSearchField"
               onAction="#handleArtistSearch"
               promptText="Escribe un artista y pulsa Enter..."/>

    <ListView fx:id="songListView" VBox.vgrow="ALWAYS" />

    <Button text="Modo Rock Clásico"
            onAction="#handleRockClasicoFilter"
            maxWidth="Infinity"/>

    <Button text="Me Gusta"
            onAction="#handleLikeButton"
            maxWidth="Infinity"
            style="-fx-background-color: #1DB954; -fx-text-fill: white;"/>

    <Button text="Mostrar Todas" onAction="#handleReset" maxWidth="Infinity"/>

</VBox>